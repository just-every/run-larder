{
  "version": 1,
  "project": "manufacturing/larder",
  "compatibilityDate": "2026-09-08",
  "compatibilityFlags": [
    "nodejs_compat"
  ],
  "d1": [
    {
      "binding": "DB"
    }
  ],
  "originVar": "AUTH_ORIGIN",
  "vars": {
    "AUTH_LOCAL": "false",
    "MAIL_PROVIDER": "resend",
    "MAIL_FROM": "auth@example.invalid"
  },
  "secrets": [
    {
      "binding": "OWNER_EMAIL",
      "environment": "OWNER_EMAIL"
    },
    {
      "binding": "SESSION_SECRET",
      "environment": "SESSION_SECRET"
    },
    {
      "binding": "SETUP_TOKEN",
      "environment": "SETUP_TOKEN"
    },
    {
      "binding": "MAIL_API_KEY",
      "environment": "MAIL_API_KEY"
    },
    {
      "binding": "INSTALLATION_KEY",
      "environment": "INSTALLATION_KEY"
    },
    {
      "binding": "RER_OWNER_CLAIM_ISSUER",
      "environment": "RER_OWNER_CLAIM_ISSUER",
      "optional": true
    },
    {
      "binding": "RER_OWNER_CLAIM_INSTALLATION_ID",
      "environment": "RER_OWNER_CLAIM_INSTALLATION_ID",
      "optional": true
    },
    {
      "binding": "RER_OWNER_CLAIM_PUBLIC_KEYS",
      "environment": "RER_OWNER_CLAIM_PUBLIC_KEYS",
      "optional": true
    },
    {
      "binding": "RER_BUSINESS_TRUST",
      "environment": "RER_BUSINESS_TRUST",
      "optional": true
    }
  ],
  "platforms": [
    "workers",
    "container"
  ]
}
